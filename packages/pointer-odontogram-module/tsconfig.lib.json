{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "noEmit": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/index.ts",
    "src/App.tsx",
    "src/odontogram.ts",
    "src/theme.ts",
    "src/plugin.ts",
    "src/status_extras.ts",
    "src/bridgeOverlay.ts",
    "src/utils/**/*.ts",
    "src/i18n/**/*.ts",
    "src/fhir/**/*.ts",
    "src/registry/**/*.ts"
  ]
}
