{
    "name": "rest-express",
    "version": "7.0.0",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,green\" --kill-others-on-fail",
        "dev:integrated": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/dev-server.ts",
        "dev:backend": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/dev-server.ts",
        "dev:frontend": "vite",
        "dev:clean": "npm run clean && npm run dev",
        "clean": "rimraf dist node_modules/.vite",
        "dev:old": "npm run build:dev && cross-env NODE_ENV=development NODE_TLS_REJECT_UNAUTHORIZED=0 tsx --require dotenv/config server/index.ts",
        "dev:no-build": "cross-env NODE_ENV=development NODE_TLS_REJECT_UNAUTHORIZED=0 tsx --require dotenv/config server/index.ts",
        "build": "node scripts/build-production.js",
        "zip": "node scripts/zip-build.js",
        "build:licensed": "node scripts/build-licensed.js",
        "build:odontogram": "npm run build:lib --prefix packages/pointer-odontogram-module",
        "build:production": "npm run build:odontogram && cross-env NODE_ENV=production vite build && node scripts/esbuild.config.js production",
        "build:development": "npm run build:odontogram && cross-env NODE_ENV=development vite build && node scripts/esbuild.config.js development",
        "build:base": "npm run build:production",
        "build:dev": "npm run build:development",
        "start": "cross-env NODE_ENV=production node --require dotenv/config dist/index.js",
        "check": "tsc",
        "db:push": "drizzle-kit push",
        "db:init": "node --experimental-modules scripts/init-multi-tenant.js",
        "db:create-schema": "node scripts/create-schema.cjs",
        "db:create-admin": "node scripts/generate-admin-password.js",
        "db:create-plans": "node --experimental-modules scripts/create-plans-table.js",
        "db:migrate": "node scripts/migrate.js run",
        "db:migrate:status": "node scripts/migrate.js status",
        "db:migrate:validate": "node scripts/migrate.js validate",
        "db:migrate:create": "node scripts/migrate.js create",
        "test:appsumo": "node --import tsx --test tests/appsumo.test.ts",
        "test:appsumo:integration": "node --experimental-test-module-mocks --import tsx --test tests/appsumo-routes.test.ts",
        "test:appsumo:browser": "node tests/appsumo.browser.test.mjs",
        "test:fixes": "node test-all-fixes.js",
        "test:contact-access": "node --import tsx --test tests/contact-access.test.ts",
        "test:contact-access:browser": "node tests/contact-add.browser.test.mjs",
        "test:migration": "node test-migration-system.js",
        "test:whatsapp": "node --import tsx --test tests/whatsapp-official-media.test.ts",
        "test:whatsapp-calling": "node --import tsx --test tests/whatsapp-calling.test.ts",
        "test:whatsapp-contact-sync": "node --experimental-test-module-mocks --import tsx --test tests/whatsapp-contact-sync-utils.test.ts tests/whatsapp-contact-sync-translations.test.ts tests/whatsapp-contact-sync-routes.test.ts tests/whatsapp-contact-sync-worker.test.ts tests/profile-picture-cache.test.ts && node tests/whatsapp-contact-sync.browser.test.mjs",
        "test:quick-actions": "node --import tsx --test tests/quick-actions.test.ts",
        "test:quick-actions:browser": "node tests/quick-actions.browser.test.mjs && node tests/create-deal-shortcut.browser.test.mjs",
        "test:erp-dashboard": "node --experimental-test-module-mocks --import tsx --test tests/dental-dashboard-routes.test.ts",
        "test:dental-queue": "node --import tsx --test tests/dental-queue.test.ts tests/dental-digital-ticket-url.test.ts",
        "test:dental-queue:browser": "node tests/dental-queue.browser.test.mjs",
        "test:dental-consent": "node --experimental-test-module-mocks --import tsx --test tests/dental-consent.test.ts tests/dental-consent-rich.test.ts tests/dental-consent-routes.test.ts tests/dental-consent-send.test.ts tests/dental-consent-media.test.ts tests/dental-consent-signatures-fields.test.ts tests/dental-clinical-progress-notes.test.ts",
        "test:dental-consent:browser": "node --import tsx tests/dental-consent.browser.test.mjs && node --import tsx tests/user-signature.browser.test.mjs",
        "test:profile:browser": "node --import tsx tests/profile.browser.test.mjs",
        "test:dental-batches": "node --import tsx --test tests/dental-reminder-batches.test.ts tests/dental-reminder-batches-routes.test.mjs tests/dental-reminder-batches-worker.test.mjs",
        "test:dental-batches:browser": "node tests/dental-reminder-batches.browser.test.mjs",
        "test:dental-reminders": "node --import tsx --test tests/dental-automatic-reminders.test.ts tests/dental-reminder-timezone.test.mjs tests/dental-reminder-settings-render.test.ts tests/dental-ai-booking-adapter.test.ts tests/dental-schedule-query.test.ts tests/booking-date-intent.test.ts tests/whatsapp-template-variables.test.ts",
        "verify:fixes": "node verify-fixes.js",
        "test:guided-tours": "node --import tsx --test tests/guided-tours.test.ts tests/guided-tour-store.test.ts tests/guided-tour-package.test.ts tests/impersonation.test.ts && node --test tests/guided-tour-routes.test.mjs",
        "test:guided-tours:browser": "node tests/guided-tours.browser.test.mjs",
        "test:guided-tours:editor": "node tests/guided-tour-editor.browser.test.mjs",
        "test:tabs": "node --test tests/tabs-inventory.test.mjs && node tests/tabs.browser.test.mjs",
        "test:account-switch:browser": "node tests/account-switch.browser.test.mjs"
    },
